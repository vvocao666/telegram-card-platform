# Owner Hybrid: same application source as Cloud Deploy, with optional RTX worker.
BOT_TOKEN=
OWNER_CHAT_ID=
LEDGER_DB_PATH=outputs/ledger.sqlite3
OCR_SPACE_API_KEY=
OCR_SPACE_API_KEYS=
REMOTE_OCR_ENABLED=true
# Fill in your own private Tailscale or LAN worker URL. Never commit it.
REMOTE_OCR_URL=http://YOUR_PRIVATE_WORKER:8000
REMOTE_OCR_TIMEOUT=1.5
REMOTE_OCR_OFFLINE_SECONDS=180
