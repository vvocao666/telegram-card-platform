# Required
BOT_TOKEN=

# Optional owner/admin chat id
OWNER_CHAT_ID=

# Ledger bookkeeping database
LEDGER_DB_PATH=outputs/ledger.sqlite3

# Optional audit bot forwarding. The receiver must start this bot first.
AUDIT_BOT_TOKEN=
AUDIT_CHAT_ID=

# Telegram/network
PROXY_URL=
TELEGRAM_TIMEOUT=60

# Batch timing
SINGLE_WAIT_SECONDS=0.6
MULTI_BATCH_WAIT_SECONDS=3.0
BATCH_WAIT_SECONDS=3.0
ALBUM_WAIT_SECONDS=3.0

# OCR provider: ocrspace or local
OCR_PROVIDER=ocrspace
OCR_SPACE_API_KEY=
OCR_SPACE_ENGINES=2,1
OCR_SPACE_TIMEOUT=18
OCR_SPACE_MAX_SIDE=2200
OCR_CONCURRENCY=5

# Local OCR fallback
LOCAL_FALLBACK=1
LOCAL_COMPLEMENT=0
VERIFY_WITH_LOCAL=0
OCR_MAX_SIDE=1800
TESSERACT_CMD=/usr/bin/tesseract

# Recognition behavior
MAX_PSN_PER_IMAGE=2
DEBUG_OCR=0

# TRX energy rental feature
TRX_DATABASE_URL=sqlite:///outputs/trx_energy_bot.db
TRX_ADMIN_IDS=
TRX_CUSTOMER_SERVICE_TEXT=请联系客服付款或咨询：@your_support
TRX_PAYMENT_ADDRESS=
TRX_SMART_COUNT_PRICE_TRX=2.5
TRX_ENERGY_PER_USDT_TRANSFER=65000
TRX_DEFAULT_PACKAGES_JSON=[{"name":"energy_65k","energy":65000,"price":2.5,"duration_hours":1},{"name":"energy_130k","energy":130000,"price":5,"duration_hours":1},{"name":"energy_325k","energy":325000,"price":12.5,"duration_hours":1}]
TRX_API_BASE_URL=https://api.kuaizu.io
TRX_API_KEY=
TRX_API_RENT_PATH=/api/rent
TRX_API_SMART_PATH=/api/ai
TRX_API_QUERY_ORDER_PATH=/orders/{api_order_id}
TRX_API_RENT_TIME=1
TRX_USE_MOCK_API=true
