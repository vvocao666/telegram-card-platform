# Required
BOT_TOKEN=

# Optional owner/admin chat id
OWNER_CHAT_ID=

# Ledger bookkeeping database
LEDGER_DB_PATH=outputs/ledger.sqlite3

# Optional audit bot forwarding. The receiver must start this bot first.
AUDIT_BOT_TOKEN=
AUDIT_CHAT_ID=

# Telegram/network
PROXY_URL=
TELEGRAM_TIMEOUT=60

# Batch timing
SINGLE_WAIT_SECONDS=0.6
MULTI_BATCH_WAIT_SECONDS=3.0
BATCH_WAIT_SECONDS=3.0
ALBUM_WAIT_SECONDS=3.0

# OCR provider: ocrspace or local
OCR_PROVIDER=ocrspace
OCR_SPACE_API_KEY=
OCR_SPACE_API_KEYS=
OCR_SPACE_ENGINES=2,1
OCR_SPACE_TIMEOUT=8
OCR_SPACE_TOTAL_TIMEOUT=8
OCR_SPACE_MAX_SIDE=2200
OCR_CONCURRENCY=20
OCR_SPACE_429_COOLDOWN_SECONDS=180

# Cloud Deploy default: keep Remote OCR disabled.
# owner-hybrid only: set REMOTE_OCR_ENABLED=true and REMOTE_OCR_URL to the private RTX5070 worker URL.
REMOTE_OCR_ENABLED=false
REMOTE_OCR_URL=
REMOTE_OCR_LABEL=Remote GPU OCR
REMOTE_OCR_TRUST_CARDS=false
REMOTE_OCR_USE_CARDS_FALLBACK=true
REMOTE_OCR_COMPLEMENT=false
REMOTE_OCR_TIMEOUT=45
REMOTE_OCR_CONNECT_TIMEOUT=1.5
REMOTE_OCR_HEALTH_CACHE_SECONDS=10
REMOTE_OCR_OFFLINE_SECONDS=180
REMOTE_OCR_PROBE_SECONDS=60

# Optional owner-hybrid CPU + RTX5070 enhancement. Keep every switch false for Cloud Deploy.
LOCAL_HYBRID_ENHANCEMENT_ENABLED=false
LOCAL_WORKER_QUEUE_V2_ENABLED=false
REMOTE_BUSY_OFFLINE_SEPARATION_ENABLED=false
LOCAL_CPU_PREPROCESS_ENABLED=false
LOCAL_CPU_OCR_ENABLED=false
LOCAL_CPU_OCR_SHADOW_ONLY=true
LOCAL_CPU_OCR_CAN_AFFECT_RESULT=false
LOCAL_ROI_REVIEW_V2_ENABLED=false
LOCAL_CPU_OCR_CONFIRMATION_MODE=strict
LOCAL_CPU_OCR_SAMPLE_RATE=1.0
REMOTE_OCR_MAX_IN_FLIGHT=20
REMOTE_OCR_BUSY_WAIT_SECONDS=45

# 0 means no hard per-batch drop limit. OCR_CONCURRENCY still bounds active work.
PHOTO_BATCH_MAX_IMAGES=0
PHOTO_RATE_WINDOW_SECONDS=60
PHOTO_RATE_LIMIT_PER_CHAT=80
PHOTO_RATE_LIMIT_PER_USER=50
OCR_PROGRESS_ENABLED=1
OCR_PROGRESS_MIN_IMAGES=3
OCR_PROGRESS_UPDATE_SECONDS=1.5

# Local OCR fallback
LOCAL_FALLBACK=1
LOCAL_COMPLEMENT=0
VERIFY_WITH_LOCAL=0
OCR_MAX_SIDE=1800
LOCAL_OCR_MIN_CARD_VOTES=2
TESSERACT_CMD=/usr/bin/tesseract

# Recognition behavior
MAX_PSN_PER_IMAGE=2
DEBUG_OCR=0
